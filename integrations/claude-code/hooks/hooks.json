{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "npx -y wingman-ai@latest load --agent claude-code --hook --quiet", "timeout": 30 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "npx -y wingman-ai@latest autosave --agent claude-code --hook --quiet", "timeout": 30 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "npx -y wingman-ai@latest autosave --agent claude-code --hook --quiet --reason compact", "timeout": 30 }] }
    ]
  }
}
